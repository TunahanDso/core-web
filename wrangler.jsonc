{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "core-web",
  "main": "vinext/server/app-router-entry",
  "compatibility_date": "2026-09-27",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "core-web-cms",
      "database_id": "7c3b6174-8deb-4934-ae53-1f3da5d944a3"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "core-web-media"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "unsafe": {
    "bindings": [
      {
        "name": "WORKER_SELF_REFERENCE",
        "type": "service",
        "service": "core-web",
        "environment": "production"
      }
    ]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "POLICY_AUD": "a63a6b694c7c45baa29b28fde72f634f5966f6e5a0275c466c384c19eb663c43",
    "TEAM_DOMAIN": "https://young-block-abfe.cloudflareaccess.com",
    "PORTAL_ALLOWED_EMAIL_DOMAINS": "std.yildiz.edu.tr",
    "PORTAL_BASE_URL": "https://ytucore.com",
    "PORTAL_MAIL_FROM": "YTÜ CORE Portal <portal@ytucore.com>"
  }
}
