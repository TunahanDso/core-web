{
  "name": "core-web",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "vite dev",
    "dev:vinext": "vinext dev --port 3001",
    "build": "vite build",
    "build:next": "next build",
    "start": "vinext start",
    "deploy": "vinext-cloudflare deploy --config dist/server/wrangler.json --skip-build",
    "typecheck": "tsc --noEmit",
    "schema:generate": "node scripts/generate-portal-migrations.mjs",
    "validate:contracts": "node scripts/validate-contracts.mjs",
    "test:unit": "node --experimental-strip-types --test tests/unit/*.test.mjs",
    "test:e2e": "node tests/e2e/live-smoke.mjs",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv worker-configuration.d.ts",
    "mobile:add:android": "cap add android",
    "mobile:add:ios": "cap add ios",
    "mobile:sync": "cap sync",
    "mobile:doctor": "cap doctor",
    "mobile:open:android": "cap open android",
    "mobile:open:ios": "cap open ios",
    "mobile:configure:android": "node mobile/scripts/configure-native.mjs android",
    "mobile:configure:ios": "node mobile/scripts/configure-native.mjs ios",
    "runner:check": "node --check services/core-runner/src/index.js && node --check services/core-runner/terminal_server.cjs && sh -n services/core-runner/start.sh && python3 -m py_compile services/core-runner/sandbox_server.py",
    "runner:deploy": "wrangler deploy -c services/core-runner/wrangler.jsonc",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:info": "tauri info"
  },
  "dependencies": {
    "@vinext/cloudflare": "1.0.0-beta.11",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-server-dom-webpack": "19.3.0",
    "vinext": "^1.0.0-beta.13",
    "jose": "^6.1.0",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/network": "8.0.1",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/status-bar": "8.0.3",
    "@capacitor/camera": "8.2.4",
    "@capacitor/barcode-scanner": "3.1.2",
    "@capacitor/push-notifications": "8.1.0",
    "@capacitor/share": "8.0.1",
    "@cloudflare/containers": "0.3.7",
    "@xterm/xterm": "6.0.0",
    "@xterm/addon-fit": "0.11.0",
    "@tauri-apps/api": "2.12.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.60.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.35",
    "typescript": "^5.6.0",
    "vite": "^8.3.1",
    "wrangler": "^4.141.0",
    "@capacitor/android": "8.5.2",
    "@capacitor/cli": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "@tauri-apps/cli": "2.12.0"
  }
}
